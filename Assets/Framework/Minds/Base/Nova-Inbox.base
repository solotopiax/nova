filters:
  and:
    - file.inFolder("4-Archives/Inbox-Legacy")
    - file.ext == "md"
properties:
  note.title:
    displayName: 标题
  note.summary:
    displayName: 摘要
  note.archived-date:
    displayName: 归档日期
views:
  - type: table
    name: 历史草稿（仅供查阅）
    order:
      - file.name
      - title
      - summary
      - archived-date
