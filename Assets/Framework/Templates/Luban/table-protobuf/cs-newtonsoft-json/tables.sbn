/// <summary>
/// 向 Nova 提供 {{__name}} 的原始文件清单与 Protobuf 解码方式。
/// </summary>
[global::UnityEngine.Scripting.Preserve]
public sealed class {{__name}}Binding : NovaFramework.Runtime.ILubanTableBinding
{
    /// <summary>
    /// 获取当前 Tables 构造需要的全部 output_data_file。
    /// </summary>
    public global::System.Collections.Generic.IReadOnlyList<string> DataFiles { get; } = new string[]
    {
        {{~for table in __tables~}}
        "{{table.output_data_file}}",
        {{~end~}}
    };

    /// <summary>
    /// 使用 Protobuf Binary 或 Protobuf JSON 原始字节构造 {{__name}}。
    /// </summary>
    /// <param name="loader">按 output_data_file 返回原始字节的加载器。</param>
    /// <returns>构造完成的 Tables 容器。</returns>
    public NovaFramework.Runtime.ILubanTables Create(global::System.Func<string, byte[]> loader)
    {
        byte[] first = loader(DataFiles[0]);
        bool json = IsJson(first);
        return json
            ? new {{__name}}(name => global::System.Text.Encoding.UTF8.GetString(loader(name)))
            : new {{__name}}(loader);
    }

    /// <summary>
    /// 判断原始数据首个非空白字节是否为 JSON 容器起始符。
    /// </summary>
    /// <param name="bytes">待判断的原始数据。</param>
    /// <returns>是否为 JSON 文本。</returns>
    private static bool IsJson(byte[] bytes)
    {
        for (int i = 0; i < bytes.Length; i++)
        {
            byte value = bytes[i];
            if (value == 0x20 || value == 0x09 || value == 0x0A || value == 0x0D)
            {
                continue;
            }
            return value == 0x7B || value == 0x5B;
        }
        return false;
    }
}
