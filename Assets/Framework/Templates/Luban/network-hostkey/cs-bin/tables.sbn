        {{~end~}}
    };

    /// <summary>
    /// 使用原始 Binary 字节构造 {{__name}}。
    /// </summary>
    /// <param name="loader">按 output_data_file 返回原始字节的加载器。</param>
    /// <returns>构造完成的 Tables 容器。</returns>
    public NovaFramework.Runtime.ILubanTables Create(global::System.Func<string, byte[]> loader)
    {
        return new {{__name}}(name => new ByteBuf(loader(name)));
    }
}

