{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nova Project Skills Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "skills"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "const": "com.solotopia.nova.framework"
    },
    "capabilityGroups": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "kind",
          "status",
          "journeys",
          "effects",
          "minimumEvidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^nova-project-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^Skills/nova-project-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "router",
              "operation",
              "workflow"
            ]
          },
          "status": {
            "enum": [
              "experimental",
              "stable",
              "deprecated"
            ]
          },
          "replacedBy": {
            "type": "string",
            "pattern": "^nova-project-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "journeys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read",
                "workspace-write",
                "unity-write",
                "generated-output",
                "build"
              ]
            }
          },
          "minimumEvidence": {
            "enum": [
              "static",
              "compile",
              "play",
              "bundle-build",
              "player-build"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "deprecated"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "replacedBy"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "replacedBy"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
